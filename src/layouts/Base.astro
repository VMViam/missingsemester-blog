---
import "../styles/tokens.css";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "The Missing Semester of Life's Education",
  description = "the writing: notes, essays and working notes",
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@75..125,400;700&family=Archivo+Narrow:wght@400;600&family=Caveat:wght@500;600;700&family=IBM+Plex+Mono:wght@400;500;600&family=Special+Elite&display=swap"
      rel="stylesheet"
    />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
  </head>
  <body>
    <header class="masthead">
      <a class="masthead__title" href="/">The Missing Semester</a>
      <a class="masthead__room" href="https://missingsemester.in">the room</a>
    </header>

    <main class="sheet">
      <slot />
    </main>

    <footer class="colophon">
      <p>
        Written on cream stock, in ink.
        <a href="https://missingsemester.in">Back to the room</a>.
      </p>
    </footer>
  </body>
</html>

<style>
  .masthead {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-m);
    max-width: var(--measure);
    margin: 0 auto;
    padding: var(--space-l) var(--space-s) 0;
    border-bottom: 1px solid var(--paper-400);
  }

  .masthead__title {
    font-family: var(--font-sign);
    font-size: var(--step-1);
    font-weight: 600;
    letter-spacing: -0.01em;
    text-decoration: none;
  }

  .masthead__room {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--fg-muted);
    text-decoration: none;
  }

  .masthead__room:hover {
    color: var(--fg-ink);
  }

  .sheet {
    max-width: var(--measure);
    margin: 0 auto;
    padding: var(--space-l) var(--space-s) var(--space-2xl);
  }

  .colophon {
    max-width: var(--measure);
    margin: 0 auto;
    padding: 0 var(--space-s) var(--space-xl);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--fg-muted);
  }

  .colophon a {
    color: inherit;
  }
</style>
