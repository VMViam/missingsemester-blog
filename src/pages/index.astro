---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";

const posts = (await getCollection("posts", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const year = (d: Date) =>
  d.toLocaleDateString("en-GB", { year: "numeric", month: "short", day: "numeric" });

const latestYear = posts[0] ? posts[0].data.date.getFullYear() : "—";
---

<Base
  title="The Desk — The Missing Semester"
  description="Notes, essays and working notes from the one-room schoolhouse."
>
  <header class="page-head">
    <h1>The Desk</h1>
    <p class="lede">
      Notes, essays, and working notes — the sentences I am trying to make add
      up to something.
    </p>

    <dl class="counts">
      <div><dt>Published</dt><dd>{posts.length}</dd></div>
      <div><dt>Latest</dt><dd>{latestYear}</dd></div>
    </dl>
  </header>

  {
    posts.length === 0 ? (
      <p class="empty">
        Nothing published yet. The paper is blank.
      </p>
    ) : (
      <ul class="posts">
        {posts.map((post) => (
          <li class="post">
            <a class="post__title" href={`/posts/${post.id}/`}>
              {post.data.title}
            </a>
            <p class="post__meta">
              <time datetime={post.data.date.toISOString()}>
                {year(post.data.date)}
              </time>
              {post.data.tags.length > 0 && <> · {post.data.tags.join(" · ")}</>}
            </p>
            {post.data.description && <p class="post__desc">{post.data.description}</p>}
          </li>
        ))}
      </ul>
    )
  }
</Base>

<style>
  h1 {
    font-size: var(--step-4);
    letter-spacing: -0.03em;
  }

  .lede {
    max-width: 44ch;
    color: var(--fg-muted);
    font-size: var(--step-1);
    line-height: 1.45;
  }

  .counts {
    display: flex;
    gap: var(--space-l);
    margin: var(--space-l) 0 0;
    padding: var(--space-s) 0;
    border-top: 1px solid var(--paper-400);
    border-bottom: 1px solid var(--paper-400);
  }

  .counts div {
    display: flex;
    flex-direction: column-reverse;
  }

  .counts dt {
    font-family: var(--font-sign);
    font-size: var(--step--1);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--fg-muted);
  }

  .counts dd {
    margin: 0;
    font-size: var(--step-2);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .empty {
    margin-top: var(--space-xl);
    color: var(--fg-muted);
    font-style: italic;
  }

  .posts {
    list-style: none;
    margin: var(--space-xl) 0 0;
    padding: 0;
  }

  .post {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: baseline;
    gap: var(--space-2xs) var(--space-l);
    padding: var(--space-m) 0;
    border-bottom: 1px solid var(--paper-300);
  }

  .post__title {
    grid-column: 1;
    font-family: var(--font-sign);
    font-size: var(--step-1);
    font-weight: 600;
    text-decoration: none;
  }

  .post__title:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .post__meta {
    grid-column: 2;
    grid-row: 1;
    margin: 0;
    text-align: right;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--fg-muted);
  }

  .post__desc {
    grid-column: 1 / -1;
    margin: var(--space-3xs) 0 0;
    color: var(--fg-muted);
  }

  @media (max-width: 560px) {
    .post {
      grid-template-columns: 1fr;
    }

    .post__meta {
      grid-column: 1;
      grid-row: auto;
      text-align: left;
    }
  }
</style>
