---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";

const posts = (await getCollection("posts", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const year = (d: Date) =>
  d.toLocaleDateString("en-GB", { year: "numeric", month: "short", day: "numeric" });
---

<Base title="The Missing Semester — writing">
  <h1>Writing</h1>

  {
    posts.length === 0 ? (
      <p class="empty">
        Nothing published yet. The paper is blank.
      </p>
    ) : (
      <ul class="posts">
        {posts.map((post) => (
          <li class="post">
            <a class="post__title" href={`/posts/${post.id}/`}>
              {post.data.title}
            </a>
            <p class="post__meta">
              <time datetime={post.data.date.toISOString()}>
                {year(post.data.date)}
              </time>
              {post.data.tags.length > 0 && <> · {post.data.tags.join(" · ")}</>}
            </p>
            {post.data.description && <p class="post__desc">{post.data.description}</p>}
          </li>
        ))}
      </ul>
    )
  }
</Base>

<style>
  h1 {
    font-family: var(--font-sign);
    font-size: var(--step-3);
  }

  .empty {
    color: var(--fg-muted);
    font-style: italic;
  }

  .posts {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .post {
    padding: var(--space-m) 0;
    border-bottom: 1px solid var(--paper-300);
  }

  .post__title {
    font-family: var(--font-sign);
    font-size: var(--step-1);
    font-weight: 600;
    text-decoration: none;
  }

  .post__title:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .post__meta {
    margin: var(--space-3xs) 0 0;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--fg-muted);
  }

  .post__desc {
    margin: var(--space-xs) 0 0;
    color: var(--fg-muted);
  }
</style>
